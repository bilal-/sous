{
  "name": "sous board tokens",
  "version": 1,
  "about": "Colours, type and spacing every sous board shares: the terminal's web page (sous serve) and Shellbell's phone screen. Each renders the same JSON with its own components, from these values.",
  "color": {
    "dark": {
      "bg": "#000000", "surface": "#0B0B0D", "surface2": "#131317", "border": "#1F1F26",
      "text": "#E8E8ED", "textMuted": "#7C7C89", "textFaint": "#4A4A55", "accent": "#A78BFA", "onAccent": "#17191D"
    },
    "light": {
      "bg": "#F8F7F4", "surface": "#FFFFFF", "surface2": "#F1EFEA", "border": "#E3E0D8",
      "text": "#17191D", "textMuted": "#5E5E6A", "textFaint": "#9A9AA5", "accent": "#7C3AED", "onAccent": "#FFFFFF"
    }
  },
  "role": {
    "needs_you":   {"dark": "#F59E0B", "light": "#B45309", "word": "needs you"},
    "in_progress": {"dark": "#A78BFA", "light": "#7C3AED", "word": "in progress"},
    "ready":       {"dark": "#10B981", "light": "#047857", "word": "ready to review"},
    "failed":      {"dark": "#F43F5E", "light": "#BE123C", "word": "failed"},
    "on_you":      {"dark": "#F59E0B", "light": "#B45309", "word": "on you"},
    "on_others":   {"dark": "#A78BFA", "light": "#7C3AED", "word": "on others"},
    "unfinished":  {"dark": "#7C7C89", "light": "#5E5E6A", "word": "unfinished"},
    "idea":        {"dark": "#38BDF8", "light": "#0369A1", "word": "idea"},
    "stale":       {"dark": "#7C7C89", "light": "#5E5E6A", "word": "stale"}
  },
  "font": {
    "mono": "JetBrains Mono",
    "text": "system-ui",
    "size": {"caption": 12, "body": 14, "title": 17, "headline": 22}
  },
  "radius": {"sm": 8, "md": 12, "lg": 18},
  "space": [0, 4, 8, 12, 16, 24, 32]
}
