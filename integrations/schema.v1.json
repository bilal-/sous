{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bilal-/sous/main/integrations/schema.v1.json",
  "title": "sous native integration v1 (draft until description.draft is false)",
  "oneOf": [
    {
      "$ref": "#/$defs/description"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/outcome"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "nullableTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "operation": {
      "type": "object",
      "required": [
        "argv",
        "format",
        "offline"
      ],
      "properties": {
        "argv": {
          "$ref": "#/$defs/strings"
        },
        "format": {
          "enum": [
            "json",
            "ndjson",
            "none"
          ]
        },
        "offline": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "path",
        "org",
        "name",
        "remote",
        "last_commit"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "remote": {
          "$ref": "#/$defs/nullableString"
        },
        "last_commit": {
          "$ref": "#/$defs/nullableTime"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "status",
        "error"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "timeout",
            "off"
          ]
        },
        "error": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "upstream": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "open",
            "closed",
            "unknown",
            "error"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error",
        "exit"
      ],
      "not": {
        "required": [
          "kind"
        ]
      },
      "properties": {
        "error": {
          "type": "string"
        },
        "exit": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "next": {
          "$ref": "#/$defs/strings"
        },
        "id": {
          "type": "string"
        },
        "matches": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "description": {
      "type": "object",
      "required": [
        "kind",
        "v",
        "versions",
        "draft",
        "provider",
        "protocol",
        "version",
        "repository",
        "documentation",
        "schema",
        "poll_interval_ms",
        "operations",
        "actions"
      ],
      "properties": {
        "kind": {
          "const": "description"
        },
        "v": {
          "const": 1
        },
        "provider": {
          "const": "sous"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "protocol": {
          "const": "sous.integration"
        },
        "version": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "type": "object",
          "required": [
            "describe",
            "snapshot",
            "watch",
            "context",
            "refresh"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "id",
            "project",
            "string",
            "text",
            "commit",
            "question"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "argv",
        "parameters",
        "scope",
        "format",
        "effect",
        "confirm",
        "op",
        "offline",
        "terminal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "argv": {
          "$ref": "#/$defs/strings"
        },
        "cwd": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "scope": {
          "enum": [
            "global",
            "project",
            "item"
          ]
        },
        "input": {
          "const": "stdin"
        },
        "format": {
          "enum": [
            "json",
            "terminal"
          ]
        },
        "effect": {
          "type": "string",
          "description": "read | launch | write_private | write_public; a host refuses to run an effect it does not know"
        },
        "confirm": {
          "type": "boolean"
        },
        "op": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "kind",
        "v",
        "provider",
        "revision",
        "configured",
        "available",
        "complete",
        "as_of",
        "observed_at",
        "items",
        "projects",
        "sources",
        "problems",
        "checked",
        "unavailable"
      ],
      "properties": {
        "kind": {
          "const": "snapshot"
        },
        "v": {
          "const": 1
        },
        "provider": {
          "const": "sous"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configured": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "as_of": {
          "$ref": "#/$defs/nullableTime"
        },
        "observed_at": {
          "$ref": "#/$defs/time"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "problems": {
          "$ref": "#/$defs/strings"
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "items left out to keep a watch line under --max-bytes, counted by section"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "key",
        "section",
        "actions",
        "project",
        "name",
        "kind",
        "text",
        "since",
        "reviewed_at",
        "source",
        "ref",
        "upstream",
        "run",
        "snoozed",
        "stale",
        "closed_at",
        "closed_by"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "pattern": "^(n:|s:).+$"
        },
        "section": {
          "enum": [
            "on_you",
            "on_others",
            "unfinished",
            "ideas",
            "snoozed"
          ]
        },
        "actions": {
          "$ref": "#/$defs/strings"
        },
        "project": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "me",
            "them",
            "unfinished",
            "idea"
          ]
        },
        "text": {
          "type": "string"
        },
        "since": {
          "$ref": "#/$defs/time"
        },
        "reviewed_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "source": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/nullableString"
        },
        "upstream": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/upstream"
            }
          ]
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/run"
            }
          ]
        },
        "snoozed": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "closed_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "closed_by": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "runner",
        "state",
        "text",
        "branch",
        "worktree",
        "log",
        "key",
        "brief",
        "checked_at"
      ],
      "properties": {
        "runner": {
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "needs_you",
            "done",
            "failed"
          ]
        },
        "text": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "log": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "checked_at": {
          "$ref": "#/$defs/nullableTime"
        },
        "log_tail": {
          "$ref": "#/$defs/strings"
        },
        "error": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "queued | planning | working | reviewing | blocked | needs_you | ready | approved | published | failed | stopped | discarded; open: show an unknown phase as reported, never as finished"
        },
        "reason": {
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "question": {
          "$ref": "#/$defs/question"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "fresh": {
          "type": "boolean",
          "description": "false when the runner could not be asked on the last look; show the age from checked_at"
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "token",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/strings"
        },
        "other": {
          "type": "boolean"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "base",
        "commit"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "required": [
            "changed",
            "added",
            "removed",
            "lines_added",
            "lines_removed"
          ],
          "properties": {
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "added": {
              "type": "integer",
              "minimum": 0
            },
            "removed": {
              "type": "integer",
              "minimum": 0
            },
            "lines_added": {
              "type": "integer",
              "minimum": 0
            },
            "lines_removed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "passed | failed | not_run"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "by",
            "independent"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "independent": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "stage",
        "commit"
      ],
      "properties": {
        "stage": {
          "enum": [
            "accepted",
            "pushed",
            "published"
          ]
        },
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "pr": {
          "$ref": "#/$defs/nullableString"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "board-level fields that changed; each replaces the one held",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "as_of": {
          "$ref": "#/$defs/nullableTime"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "problems": {
          "$ref": "#/$defs/strings"
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "items left out to keep a watch line under --max-bytes, counted by section"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "kind",
        "v",
        "provider",
        "type",
        "revision",
        "changes"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "v": {
          "const": 1
        },
        "provider": {
          "const": "sous"
        },
        "type": {
          "enum": [
            "snapshot",
            "changes",
            "unavailable"
          ]
        },
        "revision": {
          "type": "string"
        },
        "previous_revision": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "error": {
          "type": "string"
        },
        "exit": {
          "enum": [
            1,
            3
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "snapshot"
            }
          },
          "required": [
            "snapshot"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "changes"
            }
          },
          "required": [
            "previous_revision"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "unavailable"
            }
          },
          "required": [
            "error",
            "exit"
          ]
        }
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "type",
        "key",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "item.added",
            "item.updated",
            "item.removed"
          ]
        },
        "key": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/item"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "item.added",
                "item.updated"
              ]
            }
          },
          "required": [
            "item"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "item.removed"
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "required": [
        "kind",
        "v",
        "op",
        "action",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "outcome"
        },
        "v": {
          "const": 1
        },
        "op": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,64}$"
        },
        "action": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "done",
            "already_done",
            "in_progress",
            "refused",
            "conflict",
            "failed",
            "not_ready"
          ]
        },
        "reason": {
          "type": "string",
          "description": "refused: not_allowed_project | op_reused | op_expired | bad_input | unknown_action; conflict: stale_question | commit_changed | wrong_phase; failed: names the step, e.g. push_failed"
        },
        "item": {
          "$ref": "#/$defs/item"
        }
      }
    }
  }
}
